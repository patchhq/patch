# Copy to .env for local development
ANTHROPIC_API_KEY=

# Option A — PAT / Actions token (takes precedence over App)
GITHUB_TOKEN=

# Option B — GitHub App (see docs/github-app.md)
PATCH_GITHUB_APP_ID=
PATCH_GITHUB_APP_PRIVATE_KEY=
# PATCH_GITHUB_APP_INSTALLATION_ID=
PATCH_GITHUB_APP_INSTALL_URL=https://github.com/apps/patch-bot/installations/new

# Optional: hosted backend tenants JSON
# PATCH_TENANTS_JSON=[]
