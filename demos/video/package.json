{
  "name": "patch-demo-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render:raw": "remotion render Demo out/patch-demo.raw.mp4 --codec=h264 --pixel-format=yuv420p --image-format=png",
    "compat": "ffmpeg -y -i out/patch-demo.raw.mp4 -c:v libx264 -pix_fmt yuv420p -profile:v main -level 4.0 -colorspace bt709 -color_primaries bt709 -color_trc bt709 -c:a aac -b:a 192k -ac 2 -movflags +faststart out/patch-demo.mp4",
    "render": "pnpm render:raw && pnpm compat",
    "render:gif": "remotion render Demo out/patch-demo.gif --codec=gif --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "4.0.286",
    "@remotion/google-fonts": "4.0.286",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.286"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
