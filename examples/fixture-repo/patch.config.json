{
  "version": 1,
  "confidence_threshold": 0.7,
  "snapshot_db": ".patch/snapshots.db",
  "languages": ["typescript"],
  "max_fix_attempts": 3,
  "rules": [],
  "disable_default_rules": [],
  "model": {
    "provider": "anthropic",
    "api_key_env": "ANTHROPIC_API_KEY"
  },
  "connectors": [
    {
      "id": "fixture-fake-api",
      "type": "package-diff",
      "enabled": true,
      "import_path": "@fixture/fake-api-client",
      "options": {
        "package": "@fixture/fake-api-client",
        "registry": "npm",
        "localPath": "../fake-api-client"
      }
    },
    {
      "id": "npm-dependency-updates",
      "type": "dependency-update",
      "enabled": true,
      "import_path": "*",
      "options": {
        "includeDevDependencies": false,
        "updateTypes": ["patch", "minor"],
        "deny": ["@fixture/fake-api-client"]
      }
    }
  ]
}
