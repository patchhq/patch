{
  "name": "@patch-dev/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted orchestration: scheduler, classification, fix generation",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@patch-dev/classify": "workspace:*",
    "@patch-dev/connector-doc-scrape": "workspace:*",
    "@patch-dev/connector-openapi-diff": "workspace:*",
    "@patch-dev/connector-package-diff": "workspace:*",
    "@patch-dev/core": "workspace:*",
    "@patch-dev/fix": "workspace:*",
    "@patch-dev/github-app": "workspace:*",
    "@patch-dev/scanner-ts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
